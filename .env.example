# WordPress admin credentials used to swap the Contact Form 7 recipient
# during the contact-form suite. Replace the placeholders with your own —
# these only ever point at the staging site.
WP_ADMIN_USER=<your-wp-admin-username>
WP_ADMIN_PASS=<your-wp-admin-password>

# Throwaway address the form is temporarily re-pointed to while the
# contact-form tests run (and restored afterwards).
WP_TEST_RECIPIENT_EMAIL=<test-recipient-email>

# Optional: set to 1 to also run the happy-path test, which submits a fully
# valid form entry to WP_TEST_RECIPIENT_EMAIL. Off by default so routine
# runs never send a real submission.
# RUN_HAPPY_PATH=1

# Copy this file to .env and fill in the values.
# Never commit your .env file to version control.